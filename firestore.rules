rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 랏코 세이브: 문서 이름 = 비밀번호 해시(16자리)
    // 비밀번호를 아는 사람만 문서 이름을 알 수 있으므로, 목록 조회·삭제는 막고 이름으로 읽기/쓰기만 허용
    match /rakko/{id} {
      allow get: if id.size() == 16;
      allow list: if false;
      allow create, update: if id.size() == 16
        && request.resource.data.keys().hasOnly(['s', 'w', 't'])
        && request.resource.data.s is string
        && request.resource.data.s.size() < 20000;
      allow delete: if false;
    }
  }
}
